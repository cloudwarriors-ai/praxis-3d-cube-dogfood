{
  "$comment": "Adopted verification profile for the Praxis cube dogfood repo. The historical application baseline passed on origin/dev commit 5c6ea32 on 2026-08-28 after installing the Playwright-pinned Chromium runtime. Current-revision evidence for this evolving command set belongs in .verification/ (gitignored). FAST is intentionally undeclared because no cheap runtime heartbeat exists. Retired preview deployment is intentionally excluded because it mutates remote Docker/Tailscale state.",
  "module": {
    "automation-contract": [
      { "name": "repository-automation-contract", "command": "npm run verify:contract" }
    ],
    "cube-domain": [
      { "name": "typecheck", "command": "npm run typecheck" },
      { "name": "cube-tests", "command": "npm test -- src/cube" }
    ],
    "app-state": [
      { "name": "typecheck", "command": "npm run typecheck" },
      { "name": "store-tests", "command": "npm test -- src/store" }
    ],
    "frontend": [
      { "name": "typecheck", "command": "npm run typecheck" },
      { "name": "lint", "command": "npm run lint" },
      { "name": "production-build", "command": "npm run build" },
      { "name": "browser-tests", "command": "npm run test:e2e", "browser": true }
    ]
  },
  "full": [
    { "name": "repository-automation-contract", "command": "npm run verify:contract" },
    { "name": "typecheck", "command": "npm run typecheck" },
    { "name": "unit-tests", "command": "npm test" },
    { "name": "lint", "command": "npm run lint" },
    { "name": "production-build", "command": "npm run build" },
    { "name": "browser-tests", "command": "npm run test:e2e", "browser": true },
    { "name": "production-dependency-audit", "command": "npm audit --omit=dev --audit-level=moderate" }
